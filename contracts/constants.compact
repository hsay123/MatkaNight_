// Implements PRD §5.1 and §9.1 (Constants)
pragma language_version >= 0.23.0;

import { ZoneId } from "./types";

export const MIN_BET: Uint<64> = 1;
export const MAX_BET: Uint<64> = 1000;
export const NIGHT_STARS_PER_TOKEN: Uint<64> = 1000000;
export const MIN_BET_STARS: Uint<64> = 1000000;
