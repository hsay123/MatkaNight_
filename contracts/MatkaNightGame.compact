pragma language_version >= 0.23.0;

import CompactStandardLibrary;

export ledger houseBalance: Uint<128>;
export ledger betCommitment: Bytes<32>;
export ledger lastNonce: Uint<64>;
export ledger seedCommitment: Bytes<32>;

export circuit initializeTreasury(initialBalance: Uint<128>): [] {
    receiveUnshielded(default<Bytes<32>>, disclose(initialBalance));
    houseBalance = disclose((houseBalance + initialBalance) as Uint<128>);
}

export circuit placeBet(zonesHash: Bytes<32>, totalAmount: Uint<128>, nonce: Uint<64>): [] {
    assert(disclose(totalAmount >= 1000000), "Total bet amount must be greater than or equal to MIN_BET");
    assert(disclose(totalAmount <= 1000000000), "Total bet amount exceeds MAX_BET");
    assert(disclose(nonce > lastNonce), "Nonce must be strictly increasing to prevent replay attacks");
    betCommitment = disclose(zonesHash);
    lastNonce = disclose(nonce);
    receiveUnshielded(default<Bytes<32>>, disclose(totalAmount));
    houseBalance = disclose((houseBalance + totalAmount) as Uint<128>);
}

export circuit commitShuffleSeed(seedHash: Bytes<32>): [] {
    seedCommitment = disclose(seedHash);
}

export circuit placeBetAndCommitSeed(zonesHash: Bytes<32>, totalAmount: Uint<128>, nonce: Uint<64>, seedHash: Bytes<32>): [] {
    assert(disclose(totalAmount >= 1000000), "Total bet amount must be greater than or equal to MIN_BET");
    assert(disclose(totalAmount <= 1000000000), "Total bet amount exceeds MAX_BET");
    assert(disclose(nonce > lastNonce), "Nonce must be strictly increasing to prevent replay attacks");
    betCommitment = disclose(zonesHash);
    lastNonce = disclose(nonce);
    seedCommitment = disclose(seedHash);
    receiveUnshielded(default<Bytes<32>>, disclose(totalAmount));
    houseBalance = disclose((houseBalance + totalAmount) as Uint<128>);
}

export circuit revealAndSettle(
    revealedZonesHash: Bytes<32>,
    drawnCardRank: Uint<64>,
    drawnCardSuit: Uint<64>,
    totalPayout: Uint<128>,
    recipient: UserAddress
): [] {
    assert(disclose(revealedZonesHash == betCommitment), "Revealed zones hash does not match the bet commitment");
    if (disclose(totalPayout > 0)) {
        assert(disclose(houseBalance >= totalPayout), "Insufficient house balance for payout");
        houseBalance = disclose((houseBalance - totalPayout) as Uint<128>);
        sendUnshielded(
            default<Bytes<32>>,
            disclose(totalPayout),
            right<ContractAddress, UserAddress>(disclose(recipient))
        );
    }
}
