// Implements PRD §8.2 and §9.1 (Shared Types)
pragma language_version >= 0.23.0;

export enum Suit {
    Hearts,
    Diamonds,
    Clubs,
    Spades
}

export enum Rank {
    A, Two, Three, Four, Five, Six, Seven, Eight, Nine, Ten, J, Q, K
}

export struct Card {
    rank: Rank,
    suit: Suit
}

export enum ZoneId {
    FaceCards,
    ExactFaceCard,
    Aces,
    NumberCards,
    ExactNumberCard
}

export struct Bet {
    zone: ZoneId,
    amount: Uint<64>,
    hasExactCard: Boolean,
    exactCardRank: Rank,
    exactCardSuit: Suit
}
