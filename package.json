{
  "name": "matkanight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preprod": "VITE_MIDNIGHT_NETWORK=preprod vite --mode preprod",
    "compile:contracts": "compact compile contracts/MatkaNightGame.compact public/artifacts",
